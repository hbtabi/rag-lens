# Optional: enable LLM answers (--llm) and API embeddings (--embeddings api).
# Works with OpenAI or any OpenAI-compatible server (Ollama, LM Studio, vLLM, Groq, Together...).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
RAGLENS_CHAT_MODEL=gpt-4o-mini
RAGLENS_EMBED_MODEL=text-embedding-3-small
